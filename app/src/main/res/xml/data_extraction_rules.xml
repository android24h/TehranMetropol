<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. Map tiles and in-progress trip state are device-specific and
     large/short-lived, so they are neither backed up nor transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="osmdroid/" />
        <exclude domain="sharedpref" path="trip_session.xml" />
        <exclude domain="sharedpref" path="last_train_reminder.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="osmdroid/" />
        <exclude domain="sharedpref" path="trip_session.xml" />
        <exclude domain="sharedpref" path="last_train_reminder.xml" />
    </device-transfer>
</data-extraction-rules>
