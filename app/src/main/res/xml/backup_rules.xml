<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 11 and below. Map tiles and in-progress trip state are
     device-specific and large/short-lived, so they are not backed up. -->
<full-backup-content>
    <exclude domain="file" path="osmdroid/" />
    <exclude domain="sharedpref" path="trip_session.xml" />
    <exclude domain="sharedpref" path="last_train_reminder.xml" />
</full-backup-content>
